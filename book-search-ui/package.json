{
  "name": "book-search-ui",
  "description": "A UI to search the OpenLibrary",
  "version": "1.0.0",
  "scripts": {
    "build": "react-scripts build && mkdir build/assets && cp assets/* build/assets/ && mkdir -p ../book-search-fastapi/static/ && cp -r build/* ../book-search-fastapi/static/",
    "build-add-for back old-back-end": "&& rm -rf ../book-search/app/static/static/js/main* && rm -rf ../book-search/app/static/static/css/main* && cp -r build/* ../book-search/app/static/",
    "build:dev": "dotenv -e .env.development react-scripts build && rm -rf ../book-search/app/static/static/js/main* && rm -rf ../book-search/app/static/static/css/main* && cp -r build/* ../book-search-fastapi/static/"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "core-js": "3.6.5",
    "mobx": "6.3.13",
    "mobx-react": "7.2.1",
    "mobx-utils": "6.0.4",
    "p-limit": "^3.1.0",
    "react": "17.0.2",
    "react-bootstrap": "^2.10.6",
    "react-dom": "17.0.2",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@types/classnames": "2.2.10",
    "@types/enzyme": "3.10.13",
    "@types/jest": "27.4.0",
    "@types/react": "17.0.37",
    "@types/react-dom": "17.0.11",
    "@typescript-eslint/eslint-plugin": "5.6.0",
    "@typescript-eslint/parser": "5.6.0",
    "@wojtekmaj/enzyme-adapter-react-17": "0.6.6",
    "cypress": "10.3.1",
    "dotenv-cli": "^7.4.4",
    "enzyme": "3.11.0",
    "enzyme-to-json": "3.6.2",
    "es6-proxy-polyfill": "2.1.1",
    "eslint": "8.4.1",
    "eslint-plugin-import": "2.25.3",
    "eslint-plugin-react": "7.27.1",
    "jest": "27.4.3",
    "jest-extended": "1.2.0",
    "stylelint": "14.2.0",
    "stylelint-scss": "4.1.0",
    "typescript": "4.5.5"
  },
  "liveUpdateConfig": {
    "port": 8080,
    "host": "localhost"
  },
  "license": "UNLICENSED",
  "private": true,
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}